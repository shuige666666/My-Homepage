---
import { ArrowUpRight, CalendarRange, ChartNoAxesCombined, ChevronDown, MoveHorizontal, Star } from "@lucide/astro";
import type { AnimeEntry } from "@/types/bangumi";
import SectionHeading from "./SectionHeading.astro";
import "@/styles/watch-timeline.css";

interface Props {
  entries: AnimeEntry[];
}

const { entries } = Astro.props;
const today = new Date();
const recordDates = entries
  .map((entry) => new Date(entry.updatedAt))
  .filter((date) => !Number.isNaN(date.getTime()));
const earliestRecord = recordDates.length
  ? new Date(Math.min(...recordDates.map((date) => date.getTime())))
  : new Date(today.getFullYear(), today.getMonth() - 11, 1);
const startMonth = new Date(earliestRecord.getFullYear(), earliestRecord.getMonth(), 1);
const endMonth = new Date(today.getFullYear(), today.getMonth(), 1);
const monthCount = (endMonth.getFullYear() - startMonth.getFullYear()) * 12 + endMonth.getMonth() - startMonth.getMonth() + 1;
const months = Array.from({ length: monthCount }, (_, index) => {
  const date = new Date(startMonth.getFullYear(), startMonth.getMonth() + index, 1);
  const key = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}`;
  return {
    key,
    label: new Intl.DateTimeFormat("zh-CN", { month: "short" }).format(date),
    title: new Intl.DateTimeFormat("zh-CN", { year: "numeric", month: "long" }).format(date),
    entries: entries.filter((entry) => entry.updatedAt.startsWith(key))
      .sort((a, b) => b.updatedAt.localeCompare(a.updatedAt)),
  };
});

const ranges = [
  { value: "12", label: "近一年", months: months.slice(-12) },
  { value: "24", label: "近两年", months: months.slice(-24) },
  { value: "all", label: "全部记录", months },
];
const total = entries.length;
// 首次展示近期有记录的一页，空月份仍保留在时间轴中供选择。
const initialMonth = [...ranges[0].months].reverse().find((month) => month.entries.length) ?? months[months.length - 1];
const formatRecordDate = (value: string) => new Intl.DateTimeFormat("zh-CN", { month: "2-digit", day: "2-digit" }).format(new Date(value));
---

<section id="watching-memories" class="watch-timeline reveal" aria-label="观看时间轴" data-initial-month={initialMonth?.key}>
  <div class="timeline-topline">
    <SectionHeading title="观看时间轴" eyebrow="WATCHING RHYTHM" />
    <details class="timeline-range-picker">
      <summary>
        <CalendarRange size={14} />
        <span data-timeline-range-label>近一年</span>
        <ChevronDown size={14} />
      </summary>
      <div class="timeline-range-menu" role="group" aria-label="选择时间范围">
        {ranges.map((range) => (
          <button type="button" data-timeline-range={range.value} aria-pressed={range.value === "12" ? "true" : "false"}>
            {range.label}
          </button>
        ))}
      </div>
    </details>
  </div>
  <p class="timeline-summary"><ChartNoAxesCombined size={14} />已记录 {total} 部动画 · 按收藏记录更新时间归档</p>
  {entries.length > 0 ? (
    <>
    <div class="timeline-memory" aria-label="月度回忆">
      <div class="memory-stage">
        {months.map((month) => (
          <article
            class="memory-scene"
            data-memory-month={month.key}
            data-month-title={month.title}
            data-month-count={month.entries.length}
            hidden={month.key !== initialMonth.key}
            aria-labelledby={`memory-title-${month.key}`}
          >
            <div class="memory-art" aria-hidden="true">
              <div class="memory-deck" data-memory-deck>
                {month.entries.length ? month.entries.slice(0, 3).map((entry, index) => (
                  <figure class="memory-photo" data-memory-photo data-card-slot={index}>
                    <div class="memory-photo-image">
                      <img src={entry.image} alt="" loading="lazy" decoding="async" />
                    </div>
                    <figcaption><span>FRAME {String(index + 1).padStart(2, "0")}</span><span>{month.key.replace("-", ".")}</span></figcaption>
                  </figure>
                )) : (
                  <div class="memory-photo memory-photo-empty" data-memory-photo data-card-slot="0">
                    <CalendarRange size={26} stroke-width={1.2} />
                    <span>留白的一页</span>
                    <small>TO BE CONTINUED</small>
                  </div>
                )}
              </div>
              <div class="memory-sleeve"><span>ANIME ARCHIVE</span><i></i><span>{month.key.slice(0, 4)}</span></div>
            </div>
            <div class="memory-copy" data-memory-copy>
              <p class="memory-eyebrow">MONTHLY MEMORIES</p>
              <h3 class="memory-date" id={`memory-title-${month.key}`}>
                <span class="memory-month-number">{month.key.slice(5)}</span>
                <span class="memory-date-label"><span>月</span><span>{month.key.slice(0, 4)}</span></span>
              </h3>
              <p class="memory-count">{month.entries.length ? <>这一页，收录了 <span class="memory-count-total"><strong>{month.entries.length}</strong> 部动画</span></> : "这个月，暂时留白"}</p>
              <p class="memory-caption">{month.entries.length ? month.entries[0].nameCn || month.entries[0].name : "等待下一段故事留下痕迹。"}</p>
              <button class="memory-open" type="button" data-memory-toggle aria-expanded="false" aria-controls="timeline-memory-records" disabled={!month.entries.length}>
                <span data-memory-toggle-label>{month.entries.length ? "展开本月记录" : "暂无观看记录"}</span><ChevronDown size={14} stroke-width={1.6} />
              </button>
            </div>
          </article>
        ))}
      </div>
      <p class="memory-instruction"><MoveHorizontal size={13} stroke-width={1.5} /><span>选择下方月份，翻阅动画回忆</span></p>
    </div>
    <div class="timeline-panels">
      {ranges.map((range) => {
        const rangeMonths = range.months;
        const maxCount = Math.max(...rangeMonths.map((month) => month.entries.length), 1);
        const chartWidth = Math.max(720, rangeMonths.length * 62);
        const chartHeight = 164;
        const paddingX = 24;
        const paddingY = 22;
        const points = rangeMonths.map((month, index) => {
          const x = paddingX + ((index + 0.5) * (chartWidth - paddingX * 2)) / rangeMonths.length;
          const y = chartHeight - paddingY - (month.entries.length / maxCount) * (chartHeight - paddingY * 2);
          return { ...month, x, y, count: month.entries.length };
        });
        const polyline = points.map((point) => `${point.x},${point.y}`).join(" ");
        const area = `${paddingX},${chartHeight - paddingY} ${polyline} ${chartWidth - paddingX},${chartHeight - paddingY}`;
        return (
          <div class="timeline-panel" data-timeline-panel={range.value} hidden={range.value !== "12"}>
            <div class="timeline-chart-wrap">
              <div class="timeline-chart-canvas" style={`--timeline-width: ${chartWidth}px`} data-chart-width={chartWidth}>
                <svg class="timeline-chart" viewBox={`0 0 ${chartWidth} ${chartHeight}`} role="img" aria-label={`${range.label}观看记录折线图`}>
                  <defs>
                    <linearGradient id={`timeline-fill-${range.value}`} x1="0" x2="0" y1="0" y2="1">
                      <stop offset="0%" stop-color="#78a8c4" stop-opacity="0.33" />
                      <stop offset="100%" stop-color="#dff1f4" stop-opacity="0.04" />
                    </linearGradient>
                  </defs>
                  {[0.25, 0.5, 0.75].map((ratio) => <line class="timeline-grid-line" x1={paddingX} x2={chartWidth - paddingX} y1={paddingY + ratio * (chartHeight - paddingY * 2)} y2={paddingY + ratio * (chartHeight - paddingY * 2)} />)}
                  <polygon points={area} fill={`url(#timeline-fill-${range.value})`} />
                  <polyline points={polyline} />
                  <line class="timeline-guide" data-timeline-guide x1="0" x2="0" y1={paddingY} y2={chartHeight - paddingY} style={`transform: translateX(${points.find((point) => point.key === initialMonth.key)?.x ?? 0}px)`} />
                  {points.map((point) => <circle class:list={["timeline-point", { "is-highlighted": point.key === initialMonth.key }]} data-point-month={point.key} cx={point.x} cy={point.y} r="5" />)}
                  <g class="timeline-marker" data-timeline-marker style={`transform: translate(${points.find((point) => point.key === initialMonth.key)?.x ?? 0}px, ${points.find((point) => point.key === initialMonth.key)?.y ?? 0}px)`}>
                    <circle class="timeline-marker-halo" r="11" /><circle class="timeline-marker-core" r="5" />
                  </g>
                </svg>
                <div class="timeline-hit-areas" style={`grid-template-columns: repeat(${rangeMonths.length}, minmax(0, 1fr))`}>
                  {points.map((point) => (
                    <button class="timeline-hit-area" type="button" data-timeline-month={point.key} data-point-x={point.x} data-point-y={point.y} aria-label={`${point.title}：记录 ${point.count} 部动画`} aria-pressed={point.key === initialMonth.key ? "true" : "false"}></button>
                  ))}
                </div>
                <div class="timeline-labels" style={`grid-template-columns: repeat(${rangeMonths.length}, minmax(0, 1fr))`} aria-hidden="true">
                  {rangeMonths.map((month) => <span data-label-month={month.key} class:list={{ "is-selected": month.key === initialMonth.key }}>{month.label}</span>)}
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>
    <div class="memory-records" id="timeline-memory-records" hidden>
      {months.map((month) => (
        <section class="memory-record-month" data-record-month={month.key} hidden={month.key !== initialMonth.key} aria-labelledby={`memory-record-heading-${month.key}`}>
          <div class="memory-record-heading"><h3 id={`memory-record-heading-${month.key}`}>{month.title}的记录</h3><span>{String(month.entries.length).padStart(2, "0")} ENTRIES</span></div>
          {month.entries.length ? (
            <ul class="memory-record-list">
              {month.entries.map((entry) => (
                <li>
                  <a href={entry.url} target="_blank" rel="noreferrer" class="memory-record-link">
                    <img src={entry.image} alt="" loading="lazy" decoding="async" />
                    <span class="memory-record-text"><strong>{entry.nameCn || entry.name}</strong><span>{formatRecordDate(entry.updatedAt)} 记录</span></span>
                    <span class="memory-record-score"><Star size={12} fill="currentColor" />{entry.userScore ? entry.userScore.toFixed(1) : "—"}</span>
                    <ArrowUpRight class="memory-record-arrow" size={15} aria-hidden="true" />
                  </a>
                </li>
              ))}
            </ul>
          ) : <p class="memory-record-empty">这个月暂无观看记录。</p>}
        </section>
      ))}
    </div>
    <p class="timeline-sr-only" data-memory-status role="status" aria-live="polite" aria-atomic="true"></p>
    </>
  ) : (
    <p class="compact-empty">同步后会在这里展示每月的观看记录。</p>
  )}
</section>

<script>
  import "../scripts/watch-timeline";
</script>
