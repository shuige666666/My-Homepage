---
import type { LongReviewEntry } from "@/types/bangumi";
import "@/styles/preview-long-reviews.css";

interface Props {
  reviews: LongReviewEntry[];
  profile: {
    username: string;
    nickname: string;
    bangumiUrl: string;
  };
  motto: string;
  topId: string;
}

const { reviews, profile, motto, topId } = Astro.props;

const DEFAULT_THEMES = [
  { bg: "74, 31, 42", fg: "244, 206, 216", accent: "#B83644" },
  { bg: "27, 57, 44", fg: "213, 235, 217", accent: "#2F6F4E" },
  { bg: "27, 49, 68", fg: "212, 230, 244", accent: "#2E627C" },
  { bg: "56, 45, 36", fg: "240, 228, 212", accent: "#9B5634" },
];

const CN_DATE = new Intl.DateTimeFormat("sv-SE", { timeZone: "Asia/Shanghai" });
const EN_DATE = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "2-digit",
  year: "numeric",
  timeZone: "Asia/Shanghai",
});

function formatDates(iso: string) {
  const d = new Date(iso);
  const cn = CN_DATE.format(d);
  const [year, month, day] = cn.split("-");
  return {
    iso: cn,
    year,
    dot: `${year}.${month}.${day}`,
    en: EN_DATE.format(d),
  };
}

function splitParagraphs(content: string) {
  return String(content || "")
    .split(/\r?\n/)
    .map((line) => line.trim())
    .filter(Boolean);
}

/** 选取开篇节选段落（约 420–560 字，按自然段截止），让右侧栏有充实的停驻阅读行程。 */
function buildExcerptParagraphs(paragraphs: string[]) {
  const picked: string[] = [];
  let total = 0;
  for (let i = 0; i < paragraphs.length; i += 1) {
    const p = paragraphs[i];
    if (picked.length > 0 && (total + p.length > 600 || picked.length >= 7)) break;
    picked.push(p);
    total += p.length;
    if (total >= 420) break;
  }
  return {
    items: picked,
    truncated: picked.length < paragraphs.length,
  };
}

const blogListUrl = `https://bangumi.tv/user/${profile.username}/blog`;
const years = [...new Set(reviews.map((e) => formatDates(e.publishedAt).year))];
const firstReview = reviews[0];
const firstTheme = firstReview?.theme ?? DEFAULT_THEMES[0];
const firstHero = firstReview?.primaryVisual ?? firstReview?.gallery[0] ?? null;
---

{reviews.length > 0 && (
  <section
    class="pv-lr"
    id="preview-long-reviews"
    data-pv-long-reviews
    data-lr-first-bg={firstTheme.bg}
    data-lr-first-fg={firstTheme.fg}
    aria-label="长评"
  >
    <!-- 顶部条件显现的双层细线栏（仅进入长评区间后从顶边滑入，退回时间轴或页脚时收起） -->
    <div class="pv-lr-chrome" data-lr-chrome aria-hidden="true">
      <div class="pv-lr-topbar">
        <a class="pv-lr-brand" href={`#${topId}`}>
          <span class="pv-lr-brand-cn">我的动漫偏好</span>
          <span class="pv-lr-brand-sep">/</span>
          <span class="pv-lr-brand-en">LONG REVIEWS</span>
        </a>
        <div class="pv-lr-topbar-actions">
          <button type="button" class="pv-lr-mono-btn" data-lr-shelf-open>
            [ {String(reviews.length).padStart(2, "0")} 篇长评 ]
          </button>
          <a class="pv-lr-mono-btn" href={blogListUrl} target="_blank" rel="noreferrer">
            BANGUMI ↗
          </a>
        </div>
      </div>
      <div class="pv-lr-subbar">
        <div class="pv-lr-subbar-left">
          <span class="pv-lr-live-status" data-lr-live-status>
            [ 01 / {String(reviews.length).padStart(2, "0")} ]
          </span>
        </div>
        <div class="pv-lr-subbar-right">
          <button type="button" class="pv-lr-esc-trigger" data-lr-shelf-open>
            ← [ESC] 全部目录
          </button>
          <svg class="pv-lr-progress-ring" viewBox="0 0 22 22" aria-hidden="true">
            <circle class="pv-lr-ring-track" cx="11" cy="11" r="9" />
            <circle class="pv-lr-ring-fill" data-lr-ring-fill cx="11" cy="11" r="9" />
          </svg>
        </div>
      </div>
    </div>

    <!-- 水平滑动衬线篇目标题带（实底前景，不遮挡右侧栏） -->
    <nav class="pv-lr-marquee-rail" data-lr-marquee-rail aria-label="长评篇目跳转" aria-hidden="true">
      <div class="pv-lr-marquee-track" data-lr-marquee-track>
        {reviews.map((entry, idx) => {
          const work = entry.subjects[0]?.displayName || entry.title;
          const year = formatDates(entry.publishedAt).year;
          return (
            <button
              type="button"
              class={`pv-lr-marquee-item${idx === 0 ? " is-active" : ""}`}
              data-lr-marquee-item={`review-edition-${entry.id}`}
            >
              <span>{work}</span>
              <sup>({year})</sup>
            </button>
          );
        })}
      </div>
    </nav>

    <!-- 从浅灰绿「观看时间轴」沉降入深色「长评」的暗场过渡幕 -->
    <div class="pv-lr-curtain" data-lr-curtain>
      <div class="pv-lr-curtain-pin" data-lr-curtain-pin>
        <div class="pv-lr-curtain-inner" data-lr-curtain-copy>
          <p class="pv-lr-curtain-kicker">LONG REVIEWS · {String(reviews.length).padStart(2, "0")} 篇</p>
          <h2 class="pv-lr-curtain-title">长评</h2>
          <span class="pv-lr-curtain-rule" aria-hidden="true"></span>
        </div>
      </div>
    </div>

    <!-- 各篇长评主体（左图停驻 + 右栏长内容 + 完整 [ ARCHIVE ] 档案区与切图画廊） -->
    <div class="pv-lr-editions" data-lr-editions>
      {reviews.map((entry, idx) => {
        const no = String(idx + 1).padStart(2, "0");
        const dates = formatDates(entry.publishedAt);
        const paragraphs = splitParagraphs(entry.content);
        const excerpt = buildExcerptParagraphs(paragraphs);
        const theme = entry.theme ?? DEFAULT_THEMES[idx % DEFAULT_THEMES.length];
        const primarySubject = entry.subjects[0];
        const workName = primarySubject?.displayName || "长评";
        const heroAsset = entry.primaryVisual ?? entry.gallery[0] ?? null;
        const articleHref = `/reviews/${entry.id}`;
        const scoreText = primarySubject?.userScore ? `${primarySubject.userScore.toFixed(1)} / 10` : "已收录";

        const creditLines = primarySubject?.info?.raw
          ? [
              primarySubject.info.episodes && `话数：${primarySubject.info.episodes}`,
              primarySubject.info.airDate && `首播：${primarySubject.info.airDate}`,
              primarySubject.info.director && `监督：${primarySubject.info.director}`,
              primarySubject.info.originalWork && `原作：${primarySubject.info.originalWork}`,
              primarySubject.info.characterDesign && `人设：${primarySubject.info.characterDesign}`,
            ].filter((v): v is string => Boolean(v))
          : [];

        const shortQuotes = entry.subjects.filter((s) => s.userComment);
        const firstGallery = entry.gallery[0] ?? null;
        const firstNeedsContain =
          Boolean(firstGallery) &&
          (firstGallery!.kind === "poster" || firstGallery!.width / Math.max(1, firstGallery!.height) <= 1.05);

        return (
          <article
            id={`review-edition-${entry.id}`}
            class="pv-lr-edition"
            data-lr-theme-section
            data-lr-bg={theme.bg}
            data-lr-fg={theme.fg}
            data-lr-no={no}
            data-lr-date={dates.dot}
            data-lr-work={workName}
            data-lr-score={primarySubject?.userScore ? primarySubject.userScore.toFixed(1) : ""}
            data-lr-href={articleHref}
            aria-labelledby={`lr-title-${entry.id}`}
          >
            <div class="pv-lr-split">
              <div class="pv-lr-stage-col">
                <div class="pv-lr-stage-plate" data-lr-plate>
                  {heroAsset && (
                    <img
                      class="pv-lr-stage-backdrop"
                      data-lr-backdrop
                      src={heroAsset.src}
                      alt={heroAsset.caption || workName}
                      width={heroAsset.width}
                      height={heroAsset.height}
                      loading="eager"
                      decoding="async"
                    />
                  )}
                  {heroAsset && (
                    <button
                      type="button"
                      class="pv-lr-stage-zoom"
                      data-lr-zoom-src={heroAsset.src}
                      data-lr-zoom-caption={heroAsset.caption || workName}
                      aria-label={`放大查看《${workName}》配图`}
                    >
                      <svg class="pv-lr-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                        <circle cx="11" cy="11" r="7" />
                        <path d="m20 20-3.5-3.5M11 8v6M8 11h6" />
                      </svg>
                    </button>
                  )}
                </div>
              </div>

              <div class="pv-lr-rail-col">
                <div class="pv-lr-block">
                  <p class="pv-lr-kicker">[ LONG REVIEW {no} · {dates.dot} ]</p>
                  <h3 class="pv-lr-title" id={`lr-title-${entry.id}`}>
                    <a href={articleHref}>{entry.title}</a>
                  </h3>
                </div>

                <div class="pv-lr-block">
                  <p class="pv-lr-kicker">[ EXCERPT ]</p>
                  <div class="pv-lr-excerpt-group">
                    {excerpt.items.map((p, pIdx) => (
                      <p class="pv-lr-excerpt">
                        {p}{excerpt.truncated && pIdx === excerpt.items.length - 1 ? " ……" : ""}
                      </p>
                    ))}
                  </div>

                  <div class="pv-lr-ledger" aria-label="长评信息与阅读入口">
                    <a class="pv-lr-ledger-row" href={articleHref}>
                      <span class="pv-lr-ledger-label">阅读完整长评</span>
                      <span class="pv-lr-ledger-val">
                        {entry.charCount.toLocaleString("zh-CN")} 字 · 约 {entry.readMinutes} 分钟 ↗
                      </span>
                    </a>
                    <div class="pv-lr-ledger-row">
                      <span class="pv-lr-ledger-label">我的评分</span>
                      <span class="pv-lr-ledger-val">
                        {scoreText}{primarySubject?.bangumiScore ? ` · BGM ${primarySubject.bangumiScore.toFixed(1)}` : ""}
                      </span>
                    </div>
                    {entry.subjects.map((s) => (
                      <a class="pv-lr-ledger-row" href={s.url} target="_blank" rel="noreferrer">
                        <span class="pv-lr-ledger-label">关联条目 — {s.displayName}</span>
                        <span class="pv-lr-ledger-val">
                          {s.platform}{s.bangumiRank ? ` · #${s.bangumiRank}` : ""} ↗
                        </span>
                      </a>
                    ))}
                    <a class="pv-lr-ledger-row" href={entry.blogUrl} target="_blank" rel="noreferrer">
                      <span class="pv-lr-ledger-label">Bangumi 原文</span>
                      <span class="pv-lr-ledger-val">
                        blog/{entry.id}{entry.replies ? ` · ${entry.replies} 回复` : ""} ↗
                      </span>
                    </a>
                  </div>

                  <div class="pv-lr-pills">
                    <a class="pv-lr-pill pv-lr-pill--solid" href={articleHref}>+ 阅读全文 +</a>
                    <a class="pv-lr-pill" href={`#review-archive-${entry.id}`}>↖ 作品档案 ↗</a>
                  </div>
                </div>

                {creditLines.length > 0 && (
                  <div class="pv-lr-block">
                    <p class="pv-lr-kicker">[ SUBJECT INFO ]</p>
                    <ul class="pv-lr-rail-info">
                      {creditLines.map((line) => <li>{line}</li>)}
                    </ul>
                  </div>
                )}

                <div class="pv-lr-block">
                  <p class="pv-lr-kicker">[ RECORD ]</p>
                  <ul class="pv-lr-rail-info">
                    <li>发表时间：{dates.dot}（{dates.en}）</li>
                    <li>正文篇幅：{entry.charCount.toLocaleString("zh-CN")} 字 · 约 {entry.readMinutes} 分钟</li>
                    {primarySubject?.userScore && <li>我的评分：{primarySubject.userScore.toFixed(1)} / 10</li>}
                    {primarySubject?.bangumiScore && (
                      <li>
                        Bangumi：{primarySubject.bangumiScore.toFixed(2)} 分
                        {primarySubject.bangumiRank ? `（#${primarySubject.bangumiRank}）` : ""}
                      </li>
                    )}
                  </ul>
                </div>
              </div>
            </div>

            <!-- 保留完整 [ ARCHIVE ] 档案区与右侧 01-0N 缩略图画廊（支持后续按配置换为不同配图） -->
            <div class="pv-lr-expansion" id={`review-archive-${entry.id}`}>
              {shortQuotes.length > 0 && (
                <div class={`pv-lr-echo-grid${shortQuotes.length === 1 ? " is-single" : ""}`}>
                  {shortQuotes.map((s) => (
                    <div class="pv-lr-echo-card">
                      <span class="pv-lr-echo-mark" aria-hidden="true">“</span>
                      <div class="pv-lr-echo-source">SHORT REVIEW · 《{s.displayName}》</div>
                      <p class="pv-lr-echo-body">
                        {s.userComment.split(/\r?\n/).map((line, lIdx, arr) => (
                          <>
                            {line}
                            {lIdx < arr.length - 1 && <br />}
                          </>
                        ))}
                      </p>
                      <div class="pv-lr-echo-foot">
                        BANGUMI 短评 · {s.userScore ? `${s.userScore.toFixed(1)} / 10` : "—"}
                      </div>
                    </div>
                  ))}
                </div>
              )}

              <div class="pv-lr-colophon">
                <div>
                  <p class="pv-lr-kicker">[ ARCHIVE · 作品档案 ]</p>
                  <div class="pv-lr-specs">
                    <div class="pv-lr-spec-group">
                      <div class="pv-lr-spec-key">[ SUBJECTS ]</div>
                      <ul class="pv-lr-spec-list">
                        {entry.subjects.map((s) => (
                          <li>
                            <a href={s.url} target="_blank" rel="noreferrer">{s.displayName}</a>
                            {s.originalName ? `（${s.originalName}）` : ""}
                          </li>
                        ))}
                      </ul>
                    </div>

                    {creditLines.length > 0 && (
                      <div class="pv-lr-spec-group">
                        <div class="pv-lr-spec-key">[ CREDITS ]</div>
                        <ul class="pv-lr-spec-list">
                          {creditLines.map((line) => <li>{line}</li>)}
                        </ul>
                      </div>
                    )}

                    <div class="pv-lr-spec-group">
                      <div class="pv-lr-spec-key">[ METRICS ]</div>
                      <ul class="pv-lr-spec-list">
                        <li>发表时间：{dates.dot}（{dates.en}）</li>
                        <li>篇幅：{entry.charCount.toLocaleString("zh-CN")} 字 · 约 {entry.readMinutes} 分钟</li>
                        {primarySubject?.bangumiScore && (
                          <li>
                            Bangumi：{primarySubject.bangumiScore.toFixed(2)} 分
                            {primarySubject.bangumiRank ? `（#${primarySubject.bangumiRank}）` : ""}
                          </li>
                        )}
                        {primarySubject?.userScore && <li>我的评分：{primarySubject.userScore.toFixed(1)} / 10</li>}
                      </ul>
                    </div>

                    <div class="pv-lr-spec-group">
                      <div class="pv-lr-spec-key">[ LINKS ]</div>
                      <ul class="pv-lr-spec-list">
                        <li><a href={articleHref}>阅读完整长评 →</a></li>
                        <li><a href={entry.blogUrl} target="_blank" rel="noreferrer">Bangumi 原日志 ↗</a></li>
                      </ul>
                    </div>
                  </div>
                </div>

                {firstGallery && (
                  <div class="pv-lr-gallery" data-lr-colophon-gallery>
                    <div class="pv-lr-gallery-frame">
                      <img
                        class={`pv-lr-gallery-main${firstNeedsContain ? " is-contain" : ""}`}
                        data-lr-gallery-main
                        src={firstGallery.src}
                        alt={firstGallery.caption || workName}
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                    <div class="pv-lr-gallery-caption">
                      <span data-lr-gallery-caption>{firstGallery.caption || firstGallery.label}</span>
                      <span data-lr-gallery-index>01 / {String(entry.gallery.length).padStart(2, "0")}</span>
                    </div>
                    {entry.gallery.length > 1 && (
                      <div class="pv-lr-thumbs" role="group" aria-label={`切换《${workName}》关联图片`}>
                        {entry.gallery.slice(0, 5).map((img, gIdx) => {
                          const code = String(gIdx + 1).padStart(2, "0");
                          const needsContain = img.kind === "poster" || img.width / Math.max(1, img.height) <= 1.05;
                          return (
                            <button
                              type="button"
                              class="pv-lr-thumb-btn"
                              data-lr-thumb-btn
                              data-src={img.src}
                              data-alt={img.caption || img.label}
                              data-caption={img.caption || img.label}
                              data-index={`${code} / ${String(entry.gallery.length).padStart(2, "0")}`}
                              data-kind={img.kind}
                              data-fit={needsContain ? "contain" : "cover"}
                              aria-pressed={gIdx === 0 ? "true" : "false"}
                            >
                              <span class="pv-lr-thumb-box">
                                <img src={img.src} alt="" loading="lazy" decoding="async" />
                              </span>
                              <span class="pv-lr-thumb-idx">{code}</span>
                            </button>
                          );
                        })}
                      </div>
                    )}
                  </div>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <!-- 尾声宣言带：背景从末篇深色平滑回归主站浅纸白 #f8faf7，自然衔接底部 pv-footer-band -->
    <div
      class="pv-lr-outro"
      data-lr-theme-section
      data-lr-outro
      data-lr-bg="248, 250, 247"
      data-lr-fg="37, 62, 73"
    >
      <div class="pv-lr-outro-inner pv-container">
        <p class="pv-lr-outro-kicker">[ LONG REVIEWS · 长评 ]</p>
        <p class="pv-lr-manifesto">{motto}</p>
        <div class="pv-lr-outro-links">
          {reviews.map((e, i) => (
            <a href={`/reviews/${e.id}`}>
              {String(i + 1).padStart(2, "0")} {e.subjects[0]?.displayName || e.title}
            </a>
          ))}
          <a href={blogListUrl} target="_blank" rel="noreferrer">Bangumi 日志 ↗</a>
        </div>
      </div>
    </div>

    <!-- 左下角极简直达条（仅长评激活期间显现） -->
    {firstReview && (
      <a class="pv-lr-dock" data-lr-dock href={`/reviews/${firstReview.id}`} aria-hidden="true">
        <span>▸</span>
        <span>NO.01 {firstReview.subjects[0]?.displayName || ""}</span>
      </a>
    )}

    <!-- [ESC] 全屏长评目录抽屉 -->
    <aside class="pv-lr-shelf" data-lr-shelf aria-hidden="true" aria-label="全部长评目录">
      <div class="pv-lr-shelf-head">
        <span>[ LONG REVIEWS · 全部目录 ]</span>
        <div class="pv-lr-shelf-filters" role="group" aria-label="按年份筛选">
          <button type="button" class="pv-lr-shelf-filter" data-lr-shelf-filter="all" aria-pressed="true">
            全部 ({reviews.length})
          </button>
          {years.map((y) => (
            <button type="button" class="pv-lr-shelf-filter" data-lr-shelf-filter={y} aria-pressed="false">
              {y}
            </button>
          ))}
        </div>
        <button type="button" class="pv-lr-shelf-close" data-lr-shelf-close>[ESC] 关闭 ✕</button>
      </div>

      <div class="pv-lr-shelf-body">
        <ol class="pv-lr-shelf-list">
          {reviews.map((entry, idx) => {
            const no = String(idx + 1).padStart(2, "0");
            const dates = formatDates(entry.publishedAt);
            const primary = entry.subjects[0];
            const workName = primary?.displayName || "长评";
            const preview = entry.primaryVisual ?? entry.gallery[0] ?? null;
            return (
              <li
                class={`pv-lr-shelf-row${idx === 0 ? " is-previewed" : ""}`}
                data-lr-shelf-row
                data-year={dates.year}
                data-preview-src={preview?.src || ""}
                data-preview-title={workName}
                data-preview-meta={`${dates.dot} · ${entry.charCount} 字`}
              >
                <span class="pv-lr-shelf-num">{no}</span>
                <span class="pv-lr-shelf-date">{dates.dot}</span>
                <div class="pv-lr-shelf-titles">
                  <a href={`/reviews/${entry.id}`}><strong>{entry.title}</strong></a>
                  <span>
                    {workName}{primary?.userScore ? ` · 评分 ${primary.userScore.toFixed(1)}` : ""} · 约 {entry.readMinutes} 分钟
                  </span>
                </div>
                <div class="pv-lr-shelf-actions">
                  <button type="button" class="pv-lr-shelf-read" data-lr-shelf-jump={`review-edition-${entry.id}`}>
                    定位
                  </button>
                  <a class="pv-lr-shelf-read" href={`/reviews/${entry.id}`}>阅读全文 →</a>
                </div>
              </li>
            );
          })}
        </ol>

        <div class="pv-lr-shelf-preview" aria-hidden="true">
          <div class="pv-lr-shelf-preview-frame">
            {firstHero && <img data-lr-shelf-preview-img src={firstHero.src} alt="" />}
          </div>
          <div class="pv-lr-shelf-preview-cap">
            <span data-lr-shelf-preview-title>{firstReview?.subjects[0]?.displayName || ""}</span>
            <span data-lr-shelf-preview-meta>
              {firstReview ? `${formatDates(firstReview.publishedAt).dot} · ${firstReview.charCount} 字` : ""}
            </span>
          </div>
        </div>
      </div>

      <div class="pv-lr-shelf-foot">
        <span>在长评区按 ESC 打开或关闭目录</span>
        <span>{profile.nickname} · BANGUMI / {profile.username}</span>
      </div>
    </aside>

    <!-- 配图放大灯箱 -->
    <dialog class="pv-lr-lightbox" data-lr-lightbox aria-label="图片预览">
      <button type="button" class="pv-lr-lightbox-close" data-lr-lightbox-close>ESC / 关闭 ✕</button>
      <div class="pv-lr-lightbox-inner">
        <img data-lr-lightbox-img src="" alt="" />
        <div class="pv-lr-lightbox-cap" data-lr-lightbox-cap></div>
      </div>
    </dialog>
  </section>
)}
