---
import type { AnimeEntry } from "@/types/bangumi";

interface Props { watched: AnimeEntry[]; }
const { watched } = Astro.props;
const first = watched[0];
const formatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
  timeZone: "Asia/Shanghai",
});
---

<!-- 参考 Toolkit 的固定舞台与扇形轮轴，海报和文字使用本站实际记录。 -->
<section class="pv-journal" id="preview-journal" aria-labelledby="preview-journal-title" data-pv-journal>
  <div class="pv-journal__pin" data-pv-journal-pin>
    <header class="pv-journal__header">
      <h2 id="preview-journal-title">最近看过</h2>
      {first && <div class="pv-journal__current">
        <a href={first.url} target="_blank" rel="noreferrer" data-pv-journal-title>{first.nameCn || first.name}</a>
        <time datetime={first.updatedAt} data-pv-journal-date>{formatter.format(new Date(first.updatedAt))}</time>
      </div>}
    </header>

    {first ? <>
      <div class="pv-journal__wheel" data-pv-journal-wheel tabindex="0" role="region" aria-label="最近看过的动画，滚动或使用左右方向键浏览">
        {watched.map((entry, index) => (
          <article class="pv-journal__slot" data-pv-journal-slot>
            <a class="pv-journal__card" href={entry.url} target="_blank" rel="noreferrer">
              <span class="pv-journal__frame">
                <img src={entry.image} alt="" loading="lazy" decoding="async" />
                {index === watched.length - 1 && (
                  <svg class="pv-journal__wave" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                    <path data-pv-journal-wave />
                  </svg>
                )}
              </span>
              <span class="pv-journal__caption">
                <strong>{entry.nameCn || entry.name}</strong>
                <time datetime={entry.updatedAt}>{formatter.format(new Date(entry.updatedAt))}</time>
              </span>
            </a>
          </article>
        ))}
      </div>
    </> : <p class="pv-empty">暂无观看记录。</p>}
  </div>
</section>
