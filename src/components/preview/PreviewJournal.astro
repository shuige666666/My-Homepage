---
import { ArrowUpRight, ChevronLeft, ChevronRight } from "@lucide/astro";
import type { AnimeEntry } from "@/types/bangumi";

interface Props { watched: AnimeEntry[]; }
const { watched } = Astro.props;
const formatter = new Intl.DateTimeFormat("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit", timeZone: "Asia/Shanghai" });
---

<!-- 最近看过独立成屏，横向浏览全部十条记录，不把短评挤进海报区。 -->
<section class="pv-journal pv-container pv-section" id="preview-journal" aria-labelledby="preview-journal-title" data-pv-motion-section>
  <div class="pv-section-heading" data-pv-reveal>
    <h2 id="preview-journal-title">最近看过</h2>
    {watched.length > 0 && <div class="pv-rail-controls">
      <span class="pv-rail-count" data-pv-watched-count aria-live="polite">01 / {String(watched.length).padStart(2, "0")}</span>
      <button type="button" data-pv-watched-prev aria-controls="preview-watched-rail" aria-label="向前浏览最近看过" disabled><ChevronLeft size={21} /></button>
      <button type="button" data-pv-watched-next aria-controls="preview-watched-rail" aria-label="向后浏览最近看过"><ChevronRight size={21} /></button>
    </div>}
  </div>
  {watched.length > 0 ? <>
    <div class="pv-watched-stage">
      <div class="pv-watched-rail" id="preview-watched-rail" data-pv-watched-rail tabindex="0" role="region" aria-label="最近看过的动画，可横向滚动或使用左右方向键">
        {watched.map((entry, index) => <article class="pv-watched-card" data-pv-reveal style={`--pv-stagger: ${index % 4}; --pv-tilt: ${index % 2 === 0 ? -1 : 1}`}>
          <a href={entry.url} target="_blank" rel="noreferrer" aria-label={`在 Bangumi 查看${entry.nameCn || entry.name}`}>
            <div class="pv-watched-visual"><div class="pv-watched-cover"><img src={entry.image} alt="" loading="lazy" decoding="async" /><span class="pv-cover-open" aria-hidden="true"><ArrowUpRight size={23} /></span></div></div>
            <div class="pv-watched-meta"><span>{String(index + 1).padStart(2, "0")}</span><time datetime={entry.updatedAt} title="收藏记录更新时间">{formatter.format(new Date(entry.updatedAt))}</time></div>
            <h3>{entry.nameCn || entry.name}</h3>
          </a>
        </article>)}
      </div>
    </div>
    <div class="pv-rail-track" aria-hidden="true"><span data-pv-watched-progress></span></div>
  </> : <p class="pv-empty">暂无观看记录。</p>}
</section>
